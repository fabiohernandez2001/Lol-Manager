# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lol_manager_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Riot API Configuration
RIOT_API_KEY=your-riot-api-key-here

# Rate Limiting Configuration (requests per second and per 2 minutes)
RIOT_RATE_LIMIT_PER_SECOND=20
RIOT_RATE_LIMIT_PER_2MIN=100

# CORS Settings (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery Configuration
# Development (local Redis): redis://localhost:6379/0
# Production (Upstash): rediss://default:your-password@endpoint.upstash.io:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional: Celery settings
CELERY_TASK_ALWAYS_EAGER=False  # Set to True to run tasks synchronously (testing)
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=300      # 5 minutes max per task
CELERY_TASK_SOFT_TIME_LIMIT=270 # 4.5 minutes soft limit

# Flower Monitoring
FLOWER_BASIC_AUTH=admin:your-secure-password
FLOWER_PORT=5555
